# OPENAI_API_KEY=

# Optional overrides
# BRIEF_WEEK_ANTHROPIC_MODEL=claude-haiku-5-5
# BRIEF_WEEK_OPENAI_MODEL=gpt-4o-mini
# BRIEF_WEEK_MODEL=heuristic
